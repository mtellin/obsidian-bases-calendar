filters:
  and:
    - file.hasTag("event")
views:
  - type: calendar
    name: Calendar
    order:
      - file.name
      - note.people
    startDate: note.date
    endDate: note.endDate
    colorProperty: note.color
    weekStartDay: monday
    scrollToTime: "08:00:00"
  - type: calendar
    name: Calendar by duration
    startDate: note.date
    durationProperty: note.duration_min
    weekStartDay: monday
    scrollToTime: "08:00:00"
